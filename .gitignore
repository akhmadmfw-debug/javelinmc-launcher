# Готовые сборки — их место в релизах, а не в исходниках
dist/
node_modules/

# Встроенная Java для Windows. В репозиторий она НЕ кладётся: один только файл
# runtime/lib/modules весит 122 МБ, а GitHub не принимает файлы больше 100 МБ.
# Windows-версия поэтому собирается на своём компьютере, где эта папка есть.
# Маковской сборке она не нужна вовсе — там Java скачивается при первом запуске.
runtime/

# Ключи. В config.json лежит ключ CurseForge, и в открытом репозитории ему не
# место. На сборке этот файл создаётся из секрета JV_CONFIG (см. build.yml).
config.json

# Склад jar-ников OptiFine — 188 МБ. В сборку они не входят: лаунчер качает
# OptiFine из релиза на GitHub. Плюс лицензия OptiFine запрещает раздавать их.
optifine-jars/

# Старые копии проекта
_BACKUP-*/

# Мелочь
*.log
.DS_Store
Thumbs.db

# Случайные старые копии разметки
mnt/
